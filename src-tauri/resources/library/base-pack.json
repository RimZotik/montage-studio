{
  "pack": {
    "id": "base",
    "name": { "ru": "Базовый", "en": "Base" },
    "description": { "ru": "Простые эффекты и инструменты, которые идут с программой", "en": "Simple effects and tools that come with the app" },
    "author": "studio",
    "readonly": true,
    "packVersion": 1
  },
  "items": [
    {
      "id": "fade-in", "kind": "effect", "author": "studio",
      "name": { "ru": "Плавное появление", "en": "Fade in" },
      "description": { "ru": "Клип проявляется из прозрачности", "en": "The clip appears from transparent" },
      "targets": ["video", "text"],
      "controls": [{ "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 3, "step": 0.05, "unit": "s", "default": 0.5 }],
      "spec": { "tracks": [{ "prop": "opacity", "anchor": "start", "keys": [[0, 0], ["$duration", 1]] }] }
    },
    {
      "id": "fade-out", "kind": "effect", "author": "studio",
      "name": { "ru": "Плавное исчезновение", "en": "Fade out" },
      "description": { "ru": "Клип растворяется к концу", "en": "The clip dissolves at the end" },
      "targets": ["video", "text"],
      "controls": [{ "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 3, "step": 0.05, "unit": "s", "default": 0.5 }],
      "spec": { "tracks": [{ "prop": "opacity", "anchor": "end", "keys": [["-$duration", 1], [0, 0]] }] }
    },
    {
      "id": "zoom-slow", "kind": "effect", "author": "studio",
      "name": { "ru": "Медленное приближение", "en": "Slow zoom" },
      "description": { "ru": "Кадр плавно растет на всю длину клипа", "en": "The frame slowly grows over the whole clip" },
      "targets": ["video"],
      "controls": [
        { "type": "slider", "id": "from", "label": { "ru": "Начальный масштаб", "en": "Start scale" }, "min": 0.5, "max": 3, "step": 0.01, "default": 1 },
        { "type": "slider", "id": "to", "label": { "ru": "Конечный масштаб", "en": "End scale" }, "min": 0.5, "max": 3, "step": 0.01, "default": 1.15 }
      ],
      "spec": { "tracks": [{ "prop": "scale", "anchor": "span", "keys": [[0, "$from"], [1, "$to"]], "ease": "linear" }] }
    },
    {
      "id": "punch-in", "kind": "effect", "author": "studio",
      "name": { "ru": "Удар приближением", "en": "Punch in" },
      "description": { "ru": "Резкий толчок масштаба в начале клипа: для нарезки под бит", "en": "A sharp scale hit at the clip start: for cuts to the beat" },
      "targets": ["video"],
      "controls": [
        { "type": "slider", "id": "power", "label": { "ru": "Сила", "en": "Power" }, "min": 1, "max": 2, "step": 0.01, "default": 1.18 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 1, "step": 0.01, "unit": "s", "default": 0.22 }
      ],
      "spec": { "tracks": [{ "prop": "scale", "anchor": "start", "keys": [[0, "$power"], ["$duration", 1]], "ease": "out" }] }
    },
    {
      "id": "flash", "kind": "effect", "author": "studio",
      "name": { "ru": "Вспышка", "en": "Flash" },
      "description": { "ru": "Яркая вспышка в начале клипа", "en": "A bright flash at the clip start" },
      "targets": ["video", "transition"],
      "controls": [
        { "type": "slider", "id": "power", "label": { "ru": "Яркость", "en": "Brightness" }, "min": 1, "max": 6, "step": 0.1, "default": 3 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.03, "max": 1, "step": 0.01, "unit": "s", "default": 0.15 }
      ],
      "spec": { "tracks": [{ "prop": "brightness", "anchor": "start", "keys": [[0, "$power"], ["$duration", 1]], "ease": "out" }] }
    },
    {
      "id": "shake", "kind": "effect", "author": "studio",
      "name": { "ru": "Тряска", "en": "Shake" },
      "description": { "ru": "Дрожание кадра", "en": "A trembling frame" },
      "targets": ["video", "text"],
      "controls": [
        { "type": "slider", "id": "amp", "label": { "ru": "Размах", "en": "Amount" }, "min": 0, "max": 80, "step": 1, "unit": "px", "default": 14 },
        { "type": "slider", "id": "freq", "label": { "ru": "Скорость", "en": "Speed" }, "min": 1, "max": 30, "step": 0.5, "unit": "Hz", "default": 11 }
      ],
      "spec": { "tracks": [{ "prop": "x", "wave": { "amp": "$amp", "freq": "$freq" } }, { "prop": "y", "wave": { "amp": "$amp*0.7", "freq": "$freq*1.3" } }] }
    },
    {
      "id": "blur", "kind": "effect", "author": "studio",
      "name": { "ru": "Размытие", "en": "Blur" },
      "description": { "ru": "Размывает кадр", "en": "Blurs the frame" },
      "targets": ["video"],
      "controls": [{ "type": "slider", "id": "amount", "label": { "ru": "Сила", "en": "Amount" }, "min": 0, "max": 60, "step": 0.5, "unit": "px", "default": 8 }],
      "spec": { "tracks": [{ "prop": "blur", "value": "$amount" }] }
    },
    {
      "id": "color-adjust", "kind": "effect", "author": "studio",
      "name": { "ru": "Коррекция цвета", "en": "Color adjust" },
      "description": { "ru": "Яркость, контраст, насыщенность и оттенок", "en": "Brightness, contrast, saturation and hue" },
      "targets": ["video"],
      "controls": [
        { "type": "slider", "id": "brightness", "label": { "ru": "Яркость", "en": "Brightness" }, "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "type": "slider", "id": "contrast", "label": { "ru": "Контраст", "en": "Contrast" }, "min": 0, "max": 2, "step": 0.01, "default": 1 },
        { "type": "slider", "id": "saturate", "label": { "ru": "Насыщенность", "en": "Saturation" }, "min": 0, "max": 3, "step": 0.01, "default": 1 },
        { "type": "slider", "id": "hue", "label": { "ru": "Оттенок", "en": "Hue" }, "min": -180, "max": 180, "step": 1, "unit": "°", "default": 0 }
      ],
      "spec": { "tracks": [{ "prop": "brightness", "value": "$brightness" }, { "prop": "contrast", "value": "$contrast" }, { "prop": "saturate", "value": "$saturate" }, { "prop": "hue", "value": "$hue" }] }
    },
    {
      "id": "black-white", "kind": "effect", "author": "studio",
      "name": { "ru": "Черно-белое", "en": "Black and white" },
      "description": { "ru": "Убирает цвет", "en": "Removes color" },
      "targets": ["video"],
      "controls": [{ "type": "slider", "id": "amount", "label": { "ru": "Сила", "en": "Amount" }, "min": 0, "max": 1, "step": 0.01, "default": 1 }],
      "spec": { "tracks": [{ "prop": "grayscale", "value": "$amount" }] }
    },
    {
      "id": "sepia", "kind": "effect", "author": "studio",
      "name": { "ru": "Сепия", "en": "Sepia" },
      "description": { "ru": "Теплый старый снимок", "en": "A warm old photo" },
      "targets": ["video"],
      "controls": [{ "type": "slider", "id": "amount", "label": { "ru": "Сила", "en": "Amount" }, "min": 0, "max": 1, "step": 0.01, "default": 0.8 }],
      "spec": { "tracks": [{ "prop": "sepia", "value": "$amount" }] }
    },
    {
      "id": "crossfade", "kind": "effect", "author": "studio",
      "name": { "ru": "Наплыв", "en": "Crossfade" },
      "description": { "ru": "Переход: клип проявляется поверх предыдущего. Клипы должны перекрываться", "en": "Transition: the clip appears over the previous one. Clips must overlap" },
      "targets": ["transition"],
      "controls": [{ "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 3, "step": 0.05, "unit": "s", "default": 0.5 }],
      "spec": { "tracks": [{ "prop": "opacity", "anchor": "start", "keys": [[0, 0], ["$duration", 1]], "ease": "inOut" }] }
    },
    {
      "id": "slide-in", "kind": "effect", "author": "studio",
      "name": { "ru": "Въезд сбоку", "en": "Slide in" },
      "description": { "ru": "Переход: клип въезжает в кадр", "en": "Transition: the clip slides into the frame" },
      "targets": ["transition", "text"],
      "controls": [
        { "type": "slider", "id": "distance", "label": { "ru": "Откуда", "en": "From" }, "min": -2000, "max": 2000, "step": 10, "unit": "px", "default": 1080 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 2, "step": 0.01, "unit": "s", "default": 0.3 }
      ],
      "spec": { "tracks": [{ "prop": "x", "anchor": "start", "keys": [[0, "$distance"], ["$duration", 0]], "ease": "out" }] }
    },
    {
      "id": "zoom-transition", "kind": "effect", "author": "studio",
      "name": { "ru": "Переход приближением", "en": "Zoom transition" },
      "description": { "ru": "Клип появляется из сильного приближения с размытием", "en": "The clip appears from a strong zoom with blur" },
      "targets": ["transition"],
      "controls": [
        { "type": "slider", "id": "power", "label": { "ru": "Приближение", "en": "Zoom" }, "min": 1, "max": 4, "step": 0.01, "default": 1.8 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 2, "step": 0.01, "unit": "s", "default": 0.3 }
      ],
      "spec": { "tracks": [{ "prop": "scale", "anchor": "start", "keys": [[0, "$power"], ["$duration", 1]], "ease": "out" }, { "prop": "blur", "anchor": "start", "keys": [[0, 24], ["$duration", 0]], "ease": "out" }, { "prop": "opacity", "anchor": "start", "keys": [[0, 0], ["$duration*0.5", 1]] }] }
    },
    {
      "id": "text-pop", "kind": "effect", "author": "studio",
      "name": { "ru": "Текст: выскакивает", "en": "Text: pop" },
      "description": { "ru": "Текст появляется упругим увеличением", "en": "The text appears with a springy scale" },
      "targets": ["text"],
      "controls": [
        { "type": "slider", "id": "from", "label": { "ru": "Начальный размер", "en": "Start size" }, "min": 0, "max": 1, "step": 0.01, "default": 0.5 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 1, "step": 0.01, "unit": "s", "default": 0.22 }
      ],
      "spec": { "tracks": [{ "prop": "scale", "anchor": "start", "keys": [[0, "$from"], ["$duration", 1]], "ease": "back" }, { "prop": "opacity", "anchor": "start", "keys": [[0, 0], ["$duration*0.4", 1]] }] }
    },
    {
      "id": "text-rise", "kind": "effect", "author": "studio",
      "name": { "ru": "Текст: всплывает", "en": "Text: rise" },
      "description": { "ru": "Текст поднимается снизу и проявляется", "en": "The text rises from below and appears" },
      "targets": ["text"],
      "controls": [
        { "type": "slider", "id": "distance", "label": { "ru": "Расстояние", "en": "Distance" }, "min": 0, "max": 400, "step": 5, "unit": "px", "default": 60 },
        { "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 1, "step": 0.01, "unit": "s", "default": 0.25 }
      ],
      "spec": { "tracks": [{ "prop": "y", "anchor": "start", "keys": [[0, "$distance"], ["$duration", 0]], "ease": "out" }, { "prop": "opacity", "anchor": "start", "keys": [[0, 0], ["$duration", 1]] }] }
    },
    {
      "id": "text-color", "kind": "effect", "author": "studio",
      "name": { "ru": "Текст: цвет", "en": "Text: color" },
      "description": { "ru": "Цвет букв и плашка за текстом", "en": "Letter color and a plate behind the text" },
      "targets": ["text"],
      "controls": [
        { "type": "color", "id": "color", "label": { "ru": "Цвет текста", "en": "Text color" }, "default": "#FFD84D" },
        { "type": "color", "id": "background", "label": { "ru": "Плашка", "en": "Plate" }, "default": "#00000000" }
      ],
      "spec": { "text": { "color": "$color", "background": "$background" } }
    },
    {
      "id": "audio-fade-in", "kind": "effect", "author": "studio",
      "name": { "ru": "Звук: нарастание", "en": "Audio: fade in" },
      "description": { "ru": "Звук плавно нарастает с начала клипа", "en": "The sound rises from the clip start" },
      "targets": ["audio"],
      "controls": [{ "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 10, "step": 0.05, "unit": "s", "default": 1 }],
      "spec": { "tracks": [{ "prop": "volume", "anchor": "start", "keys": [[0, 0], ["$duration", 1]] }] }
    },
    {
      "id": "audio-fade-out", "kind": "effect", "author": "studio",
      "name": { "ru": "Звук: затухание", "en": "Audio: fade out" },
      "description": { "ru": "Звук плавно затихает к концу клипа", "en": "The sound falls towards the clip end" },
      "targets": ["audio"],
      "controls": [{ "type": "slider", "id": "duration", "label": { "ru": "Длительность", "en": "Duration" }, "min": 0.05, "max": 10, "step": 0.05, "unit": "s", "default": 1 }],
      "spec": { "tracks": [{ "prop": "volume", "anchor": "end", "keys": [["-$duration", 1], [0, 0]] }] }
    },
    {
      "id": "beat-cut", "kind": "tool", "author": "studio", "engine": "builtin", "builtin": "beatCut",
      "name": { "ru": "Нарезка под бит", "en": "Cut to the beat" },
      "description": { "ru": "Находит удары в музыке и сам нарезает выбранные футажи и картинки: быстрые переходы точно в такт", "en": "Finds the hits in the music and cuts the selected footage and images: fast cuts right on the beat" },
      "targets": ["sequence"],
      "tags": ["phonk", "montage"],
      "controls": [
        { "type": "note", "text": { "ru": "Выдели клипы на видеодорожке; музыка — на дорожке ниже", "en": "Select clips on a video track; music goes on the track below" } },
        { "type": "section", "label": { "ru": "Музыка", "en": "Music" } },
        { "type": "track", "id": "musicTrack", "label": { "ru": "Дорожка музыки", "en": "Music track" }, "kinds": ["audio"], "default": "a2" },
        { "type": "select", "id": "band", "label": { "ru": "Что слушать", "en": "Listen to" }, "default": "bass", "options": [{ "value": "bass", "label": { "ru": "Бочка и бас", "en": "Kick and bass" } }, { "value": "full", "label": { "ru": "Весь звук", "en": "Full sound" } }] },
        { "type": "slider", "id": "sensitivity", "label": { "ru": "Чувствительность", "en": "Sensitivity" }, "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "section", "label": { "ru": "Нарезка", "en": "Cutting" } },
        { "type": "slider", "id": "minGap", "label": { "ru": "Минимум между склейками", "en": "Minimum between cuts" }, "min": 0.05, "max": 3, "step": 0.01, "unit": "s", "default": 0.25 },
        { "type": "number", "id": "every", "label": { "ru": "Каждый N-й удар", "en": "Every Nth hit" }, "min": 1, "max": 16, "step": 1, "default": 1 },
        { "type": "number", "id": "length", "label": { "ru": "Длина ролика (0 — вся музыка)", "en": "Length (0 — whole music)" }, "min": 0, "max": 600, "step": 1, "unit": "s", "default": 0 },
        { "type": "toggle", "id": "shuffle", "label": { "ru": "Вперемешку", "en": "Shuffle" }, "default": false },
        { "type": "select", "id": "hit", "label": { "ru": "Эффект на склейке", "en": "Effect on each cut" }, "default": "punch-in", "options": [{ "value": "none", "label": { "ru": "Без эффекта", "en": "None" } }, { "value": "punch-in", "label": { "ru": "Удар приближением", "en": "Punch in" } }, { "value": "flash", "label": { "ru": "Вспышка", "en": "Flash" } }] }
      ]
    },
    {
      "id": "remove-silence", "kind": "tool", "author": "studio", "engine": "builtin", "builtin": "removeSilence",
      "name": { "ru": "Вырезать паузы", "en": "Remove pauses" },
      "description": { "ru": "Находит паузы в речи и вырезает их со сдвигом; связанная картинка и субтитры едут вместе", "en": "Finds pauses in speech and removes them with ripple; linked video and captions move along" },
      "targets": ["sequence", "audio"],
      "controls": [
        { "type": "track", "id": "track", "label": { "ru": "Дорожка голоса (если клипы не выбраны)", "en": "Voice track (if no clips are selected)" }, "kinds": ["audio"], "default": "a1" },
        { "type": "slider", "id": "threshold", "label": { "ru": "Тишина тише чем", "en": "Silence below" }, "min": -70, "max": -10, "step": 1, "unit": "dB", "default": -35 },
        { "type": "slider", "id": "minPause", "label": { "ru": "Пауза от", "en": "Pause from" }, "min": 0.1, "max": 3, "step": 0.05, "unit": "s", "default": 0.5 },
        { "type": "slider", "id": "pad", "label": { "ru": "Запас у речи", "en": "Margin near speech" }, "min": 0, "max": 0.5, "step": 0.01, "unit": "s", "default": 0.1 },
        { "type": "toggle", "id": "markersOnly", "label": { "ru": "Только отметить маркерами", "en": "Mark only" }, "default": false }
      ]
    },
    {
      "id": "captions-from-speech", "kind": "tool", "author": "studio", "engine": "builtin", "builtin": "captionsFromSpeech",
      "name": { "ru": "Субтитры по голосу", "en": "Captions from speech" },
      "description": { "ru": "Распознает речь на этом компьютере и расставляет субтитры точно по словам", "en": "Recognizes speech on this computer and places captions right on the words" },
      "targets": ["sequence", "text"],
      "controls": [
        { "type": "track", "id": "voiceTrack", "label": { "ru": "Дорожка голоса (если клипы не выбраны)", "en": "Voice track (if no clips are selected)" }, "kinds": ["audio"], "default": "a1" },
        { "type": "select", "id": "language", "label": { "ru": "Язык", "en": "Language" }, "default": "auto", "options": [{ "value": "auto", "label": { "ru": "Определить", "en": "Detect" } }, { "value": "ru", "label": { "ru": "Русский", "en": "Russian" } }, { "value": "en", "label": { "ru": "Английский", "en": "English" } }] },
        { "type": "number", "id": "maxWords", "label": { "ru": "Слов на экране", "en": "Words on screen" }, "min": 1, "max": 14, "step": 1, "default": 4 },
        { "type": "number", "id": "maxChars", "label": { "ru": "Знаков на экране", "en": "Characters on screen" }, "min": 4, "max": 90, "step": 1, "default": 28 },
        { "type": "toggle", "id": "replace", "label": { "ru": "Заменить прежние субтитры", "en": "Replace previous captions" }, "default": true }
      ]
    },
    {
      "id": "normalize-loudness", "kind": "tool", "author": "studio", "engine": "builtin", "builtin": "normalize",
      "name": { "ru": "Выровнять громкость", "en": "Normalize loudness" },
      "description": { "ru": "Измеряет громкость и доводит клипы до одного уровня, файл не меняется", "en": "Measures loudness and brings clips to one level, the file is not changed" },
      "targets": ["audio"],
      "controls": [
        { "type": "track", "id": "track", "label": { "ru": "Дорожка (если клипы не выбраны)", "en": "Track (if no clips are selected)" }, "kinds": ["audio"], "default": "a1" },
        { "type": "slider", "id": "target", "label": { "ru": "Целевая громкость", "en": "Target loudness" }, "min": -30, "max": -6, "step": 0.5, "unit": "LUFS", "default": -14, "help": { "ru": "−14 — обычный уровень коротких роликов", "en": "−14 is the usual level for short videos" } }
      ]
    },
    {
      "id": "duck-music", "kind": "tool", "author": "studio", "engine": "builtin", "builtin": "duck",
      "name": { "ru": "Приглушить музыку под голос", "en": "Duck music under voice" },
      "description": { "ru": "Музыка сама становится тише, пока звучит голос, и возвращается в паузах", "en": "The music gets quieter while the voice sounds and returns in the pauses" },
      "targets": ["audio"],
      "controls": [
        { "type": "track", "id": "voiceTrack", "label": { "ru": "Дорожка голоса", "en": "Voice track" }, "kinds": ["audio"], "default": "a1" },
        { "type": "track", "id": "musicTrack", "label": { "ru": "Дорожка музыки", "en": "Music track" }, "kinds": ["audio"], "default": "a2" },
        { "type": "slider", "id": "amount", "label": { "ru": "На сколько тише", "en": "How much quieter" }, "min": -40, "max": 0, "step": 1, "unit": "dB", "default": -12 },
        { "type": "slider", "id": "attack", "label": { "ru": "Спад", "en": "Attack" }, "min": 0, "max": 2, "step": 0.01, "unit": "s", "default": 0.15 },
        { "type": "slider", "id": "release", "label": { "ru": "Возврат", "en": "Release" }, "min": 0, "max": 3, "step": 0.01, "unit": "s", "default": 0.4 },
